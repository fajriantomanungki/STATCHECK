# PostgreSQL
POSTGRES_DB=statcheck
POSTGRES_USER=statcheck
POSTGRES_PASSWORD=statcheck_dev_password
POSTGRES_PORT=5432

# Backend
APP_NAME=STATCHECK API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://statcheck:statcheck_dev_password@db:5432/statcheck
JWT_SECRET_KEY=replace_with_a_long_random_secret_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=http://localhost:3000
INITIAL_ADMIN_NIK=admin
INITIAL_ADMIN_NAME=Administrator STATCHECK
INITIAL_ADMIN_PASSWORD=Admin123!
INITIAL_SUPERVISOR_NIK=supervisor
INITIAL_SUPERVISOR_NAME=Supervisor STATCHECK
INITIAL_SUPERVISOR_PASSWORD=Supervisor123!

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
